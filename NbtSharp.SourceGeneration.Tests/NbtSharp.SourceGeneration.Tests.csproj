<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NbtSharp\NbtSharp.csproj"/>
    <ProjectReference Include="..\NbtSharp.SourceGeneration\NbtSharp.SourceGeneration.csproj"/>
  </ItemGroup>

</Project>
